---
interface Props { heading?: string; body?: string; }
const {
  heading = "Let's talk it through",
  body = 'Every situation is different. A short conversation is usually enough to tell whether there is something worth planning for — and there is no cost to having it.',
} = Astro.props;
---
<section class="cta-band">
  <div class="container">
    <h2>{heading}</h2>
    <p>{body}</p>
    <a href="/contact/" class="btn btn-primary">Get In Touch</a>
  </div>
</section>
