---
import { FIRM } from '../config';

// Hand-curated, not generated from the collection — the footer is a
// short editorial list, not an index. Edit freely.
const footerServices = [
  { href: '/services/tax-preparation/',   label: 'Tax Preparation & Filing' },
  { href: '/services/small-business/',    label: 'Small Business Advisory' },
  { href: '/services/bookkeeping/',       label: 'Bookkeeping' },
  { href: '/services/life-transitions/',  label: 'Life Transitions' },
  { href: '/services/',                   label: 'Other Services' },
];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">
          <div class="logo-name">KANON</div>
          <div class="logo-rule"></div>
          <div class="logo-tag">Tax &amp; Advisory</div>
        </div>
        <p>Expert tax and financial guidance for individuals and small businesses. Simplifying complex financial topics with clarity, confidence, and a defined plan.</p>
      </div>
      <div>
        <h2>Services</h2>
        <ul class="footer-links">
          {footerServices.map((s) => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Firm</h2>
        <ul class="footer-links">
          <li><a href="/about/">About</a></li>
          <li><a href="/insights/">Insights</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2>Contact</h2>
        <ul class="footer-links">
          <li><a href="/contact/">Send a message</a></li>
          <li><a href={`tel:${FIRM.phoneE164}`}>{FIRM.phone}</a></li>
          <li>Houston, Texas</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} Kanon Tax &amp; Advisory. All rights reserved.</span>
      <div class="footer-legal">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/disclosures/">Disclosures</a>
      </div>
    </div>
  </div>
</footer>
