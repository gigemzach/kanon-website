---
import PageLayout from '../../layouts/PageLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  {
    key: 'core',
    label: 'Core services',
    blurb:
      'The work most clients come to us for — accurate returns, clean books, and a business that stays compliant as it grows.',
  },
  {
    key: 'advisory',
    label: 'Specialized advisory',
    blurb:
      'Where a CPA earns their keep. Situations that need planning and judgment rather than data entry, and that reward getting ahead of them.',
  },
  {
    key: 'support',
    label: 'When something goes wrong',
    blurb: 'Representation and resolution if a notice arrives or a prior year needs cleaning up.',
  },
];
---
<PageLayout
  title="Services | Kanon Tax & Advisory"
  description="Tax preparation and filing, bookkeeping, small business advisory, and specialized planning for life transitions, equity compensation, and estate and gift tax."
  h1="Services"
  eyebrow="What we do"
  lede="Organized by where you are rather than by form number, because that's usually how people arrive here."
  crumbs={[{ href: '/', label: 'Home' }, { label: 'Services' }]}
>
  {groups.map((g) => (
    <section class="section" style="padding-top:40px;padding-bottom:40px;">
      <div class="container">
        <span class="cluster-tag">{g.label}</span>
        <p style="color:var(--text-secondary);max-width:64ch;margin-bottom:28px;">{g.blurb}</p>
        <div class="services-grid">
          {all.filter((s) => s.data.cluster === g.key).map((s) => (
            <ServiceCard href={`/services/${s.id}/`} title={s.data.navTitle} blurb={s.data.lede} icon={s.data.icon} />
          ))}
        </div>
      </div>
    </section>
  ))}
  <CtaBand />
</PageLayout>
