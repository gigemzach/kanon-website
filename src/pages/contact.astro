---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { FIRM } from '../config';
const [emailUser, emailDomain] = FIRM.publicEmail.split('@');
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const FORMSPREE = 'https://formspree.io/f/maqlrlap';
---
<PageLayout
  title="Contact | Kanon Tax & Advisory | Houston, TX"
  description="Get in touch with Kanon Tax & Advisory. Licensed CPA based in Houston, Texas, working with clients nationwide."
  h1="Get in touch"
  eyebrow="Contact"
  lede="Tell us what changed. We'll tell you whether it's something to deal with now or in April."
  crumbs={[{ href: '/', label: 'Home' }, { label: 'Contact' }]}
>
  <section class="section" style="padding-top:32px;">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <h2>Kanon Tax &amp; Advisory</h2>
          <p>
            Based in Houston, working with clients across the country. If you have an IRS notice with a
            response deadline, say so in your message and we'll prioritize it.
          </p>

          <div class="contact-detail">
            <div class="icon"><Icon name="doc" /></div>
            <div class="text">
              <span>Email</span>
              <a id="emailLink" href="/contact/" data-u={emailUser} data-d={emailDomain}>
                {emailUser} [at] {emailDomain}
              </a>
            </div>
          </div>
          <div class="contact-detail">
            <div class="icon"><Icon name="shield" /></div>
            <div class="text"><span>Phone</span><a href="tel:+17135613888">713-561-3888</a></div>
          </div>
          <div class="contact-detail">
            <div class="icon"><Icon name="book" /></div>
            <div class="text"><span>Fax</span>346-250-4817</div>
          </div>
          <div class="contact-detail">
            <div class="icon"><Icon name="compass" /></div>
            <div class="text"><span>Location</span>Houston, Texas</div>
          </div>

          <p style="font-size:13.5px;color:var(--text-light);margin-top:26px;line-height:1.7;">
            Please don't send Social Security numbers, account numbers, or tax documents through this
            form or by email. Once we're working together you'll get an encrypted portal for that.
          </p>
        </div>

        <div class="contact-form">
          <form id="contactForm" action={FORMSPREE} method="POST">
            <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
            <input type="hidden" name="_subject" value="New inquiry from kanonadvisory.com" />
            <p class="form-note"><span style="color:#8B3A3A;">*</span> Required</p>

            <div class="form-row">
              <div class="form-group">
                <label for="firstName">First name<span class="required">*</span></label>
                <input type="text" id="firstName" name="firstName" autocomplete="given-name" required />
              </div>
              <div class="form-group">
                <label for="lastName">Last name<span class="required">*</span></label>
                <input type="text" id="lastName" name="lastName" autocomplete="family-name" required />
              </div>
            </div>

            <div class="form-group">
              <label for="email">Email<span class="required">*</span></label>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </div>

            <div class="form-group">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="(713) 555-1234" />
            </div>

            <fieldset class="form-group" style="border:none;">
              <legend style="font-size:13px;font-weight:500;margin-bottom:8px;">What's going on? (select any)</legend>
              <div class="checkbox-grid">
                {services.map((s) => (
                  <label class="checkbox-option">
                    <input type="checkbox" name="interest" value={s.data.navTitle} />
                    {s.data.navTitle}
                  </label>
                ))}
                <label class="checkbox-option">
                  <input type="checkbox" name="interest" value="Not sure" /> Not sure
                </label>
              </div>
            </fieldset>

            <div class="form-group">
              <label for="message">What changed?<span class="required">*</span></label>
              <textarea id="message" name="message" required
                placeholder="A few sentences is plenty. What happened, and roughly when."></textarea>
            </div>

            <button type="submit" class="form-submit">Send message</button>
            <p class="form-privacy">
              Submitting this form does not create a client relationship. See our
              <a href="/privacy/">privacy notice</a>.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // Assemble the address in the browser so it is not present as a
  // harvestable mailto: in the served HTML.
  const el = document.getElementById('emailLink') as HTMLAnchorElement | null;
  if (el?.dataset.u && el.dataset.d) {
    const addr = el.dataset.u + String.fromCharCode(64) + el.dataset.d;
    el.href = 'mail' + 'to:' + addr;
    el.textContent = addr;
  }

  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('.form-submit') as HTMLButtonElement;
    const original = btn.textContent;
    btn.textContent = 'Sending…';
    btn.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error('bad response');
      btn.textContent = 'Message sent';
      btn.style.background = 'var(--steel)';
      form.reset();
    } catch {
      btn.textContent = 'Something went wrong — email us instead';
      btn.style.background = '#993C1D';
    }
    setTimeout(() => {
      btn.textContent = original;
      btn.style.background = '';
      btn.disabled = false;
    }, 5000);
  });
</script>
